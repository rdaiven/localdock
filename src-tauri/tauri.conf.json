{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalDock",
  "version": "0.1.2",
  "identifier": "com.localdock.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LocalDock",
        "width": 1040,
        "height": 700,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Daiven Reyes",
    "shortDescription": "Local dev-server control panel",
    "longDescription": "Start, stop, and monitor your local dev servers from one dashboard, with MCP support for AI assistants.",
    "copyright": "© 2026 Daiven Reyes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNDM2RkNGNTUwRTg5QTQKUldTa2lRNVZ6MjlEcjduRndwVnBrTVlJVWphYUhjQWNxcE5NRFk1elFFeXYyK1ArTHlRQlJDbm4K",
      "endpoints": [
        "https://github.com/rdaiven/localdock/releases/latest/download/latest.json"
      ]
    }
  }
}
